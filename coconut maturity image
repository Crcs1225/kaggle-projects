    "from tensorflow.keras.models import Model\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.manifold import TSNE\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import numpy as np\n",
    "\n",
    "# --- Create a feature extractor model ---\n",
    "# Take output from the second-to-last layer (before the classifier)\n",
    "feature_extractor = Model(inputs=model.input, outputs=model.layers[-2].output)\n",
    "\n",
    "# --- Extract features from validation or test set ---\n",
    "# Example: X_val, y_val are your validation images and labels\n",
    "features = feature_extractor.predict(test_images, verbose=1)\n",
    "\n",
    "# True labels (numeric)\n",
    "true_labels_idx = test_images.classes  \n",
    "\n",
    "# Convert numeric labels to class names\n",
    "true_labels = [labels[k] for k in true_labels_idx]\n",
    "\n",
    "\n",
    "\n",
    "# --- PCA to reduce dimensionality ---\n",
    "pca = PCA(n_components=50, random_state=42)\n",
    "pca_result = pca.fit_transform(features)\n",
    "\n",
    "# --- t-SNE to project into 2D ---\n",
    "tsne = TSNE(n_components=2, perplexity=30, n_iter=1000, random_state=42)\n",
    "tsne_result = tsne.fit_transform(pca_result)\n",
    "\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.scatterplot(\n",
    "    x=tsne_result[:, 0],\n",
    "    y=tsne_result[:, 1],\n",
    "    hue=true_labels,\n",
    "    palette='Spectral',\n",
    "    s=60,\n",
    "    alpha=0.8\n",
    ")\n",
    "plt.title('t-SNE Visualization (True Labels)', fontsize=16)\n",
