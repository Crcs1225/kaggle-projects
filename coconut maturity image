    "import os\n",
    "import shutil\n",
    "import zipfile\n",
    "from tqdm import tqdm\n",
    "\n",
    "# Create output folder for test data\n",
    "output_dir = \"test_data\"\n",
    "if os.path.exists(output_dir):\n",
    "    shutil.rmtree(output_dir)\n",
    "os.makedirs(output_dir, exist_ok=True)\n",
    "\n",
    "# Reverse mapping: index -> class name\n",
    "idx2class = {v: k for k, v in test_images.class_indices.items()}\n",
    "\n",
    "# Save test images into class-based folders\n",
    "for i in tqdm(range(len(test_images.filenames))):\n",
    "    filepath = test_images.filepaths[i]\n",
    "    label_idx = test_images.labels[i]   # numeric index\n",
    "    class_name = idx2class[label_idx]   # map back to string label\n",
    "    \n",
    "    # Create class folder if it doesn't exist\n",
    "    class_dir = os.path.join(output_dir, class_name)\n",
    "    os.makedirs(class_dir, exist_ok=True)\n",
    "    \n",
    "    # Copy file into the correct class folder\n",
    "    shutil.copy(filepath, class_dir)\n",
    "\n",
    "print(f\"✅ Test images copied into {output_dir}/ with class subfolders\")\n",
    "\n",
    "# Zip the folder for download\n",
    "zip_filename = \"test_data.zip\"\n",
    "with zipfile.ZipFile(zip_filename, 'w', zipfile.ZIP_DEFLATED) as zipf:\n",
    "    for root, _, files in os.walk(output_dir):\n",
    "        for file in files:\n",
    "            file_path = os.path.join(root, file)\n",
    "            arcname = os.path.relpath(file_path, output_dir)\n",
    "            zipf.write(file_path, arcname)\n",
    "\n",
    "print(f\"✅ Zipped test data into {zip_filename}\")"
